# MPLAB X / XC generated files
*.i
*.s
*.o
*.obj
*.d
*.lst
*.map
*.elf
*.hex
*.hxl
*.cof

# Exception: hand-written assembly source, not a build byproduct (generated
# .s land under build/, ignored separately). Windows Git's ignore matching is
# case-insensitive, so *.s also matches *.S.
!src/app/dspic33-cmsis-dsp/Source/**/*.s
!src/boot/resident_de_boot_precrt.S
# Same exception for hand-written assembly that belongs to an application rather
# than to the vendored (published) CMSIS-DSP tree.  -save-temps writes its dumps
# under build/ and into *.X/, never into src/, so this cannot pick one up.
!src/app/apps/**/*.s
# MPLAB X output directories
build/
dist/

# Serial update package history, written by build.ps1. Deliberately outside
# dist/ so -Clean/-Full cannot delete packages you may still want to send to
# a board.
artifacts/
.generated_files/
debug/
production/
queuelogs/

# Local build selection, written by buildtools/switch_config.ps1. Per-developer
# state, like the IDE's private/configurations.xml: never tracked.
/buildtools/active_build.json

# MPLAB X local/private project files
**/nbproject/private/
**/nbproject/Makefile-local-*.mk
**/nbproject/Makefile-genesis.properties

# MPLAB X per-configuration makefiles, regenerated from configurations.xml by
# buildtools/build.ps1 (or the IDE) -- a fresh clone needs none of them.
# Makefile-variables.mk stays tracked: same generator, but it holds no
# per-configuration selection.
**/nbproject/Makefile-dsPIC33AK*.mk
**/nbproject/Makefile-impl.mk

# MPLAB X build byproduct: copy of the device linker script the toolchain
# drops into the project dir during a build.
dspic33ak_audio_dsp.X/p33*MPS*.*.00

# MPLAB IPE / ipecmd programming logs (written in the working dir when flashing)
MPLABXLog.xml*
log.[0-9]*

# Python bytecode and MPLAB trace output.
__pycache__/
dspic33ak_audio_dsp.X/nbproject/private/
defmplabxtrace.log*

# Host-test binaries: a build product of run_host_tests.ps1, not source.
src/tests/**/out/

# Per-run measurement/build scratch these tools drop in the repository root.
/build_*.log
/flash_*.log
/gate_*.log
/sweep_*.log
/verify_*.log
/rm_*.log
/dis_*.txt
/nm_*.txt
/legs_*.txt
/tmp_*.txt
/*.jsonl

# JVM crash dumps from a Java-based flashing helper.
/hs_err_pid*.log
/replay_pid*.log
/buildtools/dfp_pack_notice.json
